# Copy to .env.local and fill in. Never commit real keys.

# Live address of the site (sitemap, robots.txt, social previews). Optional on
# Vercel, which supplies its own domain. Set it once a custom domain is added,
# e.g. https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Contact form delivery through Resend (https://resend.com).
RESEND_API_KEY=
# Inbox that receives enquiries from the contact popup.
CONTACT_TO_EMAIL=
# Sender address; must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=
